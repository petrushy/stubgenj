[case testRootJPackage]
import jpype
reveal_type(jpype.JPackage('java'))             # N: Revealed type is 'java.__module_protocol__'

[case testSubJPackage]
import jpype
java = jpype.JPackage('java')

reveal_type(java.util)                          # N: Revealed type is 'java.util.__module_protocol__'

[case testJPackageClassCreation]
import jpype
java = jpype.JPackage('java')

reveal_type(java.util.ArrayList([42]))         # N: Revealed type is 'java.util.ArrayList[builtins.int*]'

